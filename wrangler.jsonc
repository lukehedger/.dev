// lukehedger.dev: static assets on Workers, deployed by Workers Builds on push to main.
// No workers.dev or preview URLs: the custom domain is the only public address.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "lukehedger-dev",
	"compatibility_date": "2026-10-01",
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "lukehedger.dev", "custom_domain": true }],
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page",
		"html_handling": "auto-trailing-slash"
	}
}
